{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Dev (Debug, tests and examples on)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "{{PROJECT_UPPER}}_BUILD_TESTS": "ON",
                "{{PROJECT_UPPER}}_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (RelWithDebInfo)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "{{PROJECT_UPPER}}_BUILD_TESTS": "OFF",
                "{{PROJECT_UPPER}}_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "dev",
            "displayName": "Dev with AddressSanitizer and UBSan",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_INIT": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "ci",
            "inherits": "dev",
            "displayName": "CI (warnings as errors)",
            "cacheVariables": {
                "{{PROJECT_UPPER}}_WARNINGS_AS_ERRORS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev",     "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan",    "configurePreset": "asan" },
        { "name": "ci",      "configurePreset": "ci" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "dev",     "inherits": "base", "configurePreset": "dev" },
        { "name": "asan",    "inherits": "base", "configurePreset": "asan" },
        { "name": "ci",      "inherits": "base", "configurePreset": "ci" }
    ]
}
