# Git's diff driver for each kind of file, so a hunk names its function
# and a function's history finds its end. A repository's own wins.
*.c     diff=cpp
*.h     diff=cpp
*.cc    diff=cpp
*.cpp   diff=cpp
*.cxx   diff=cpp
*.hh    diff=cpp
*.hpp   diff=cpp
*.hxx   diff=cpp
*.ino   diff=cpp
*.pas   diff=pascal
*.pp    diff=pascal
*.lpr   diff=pascal
*.dpr   diff=pascal
*.rs    diff=rust
*.py    diff=python
*.go    diff=golang
*.sh    diff=bash
*.css   diff=css
*.html  diff=html
*.md    diff=markdown
*.tex   diff=tex
# Patterns for these two are in config.el.
*.el    diff=elisp
*.org   diff=org
