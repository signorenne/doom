;;; private/notes/autoload/git.el -*- lexical-binding: t; -*-
;;
;; The notes live in a git repository, so nothing written is ever lost and a
;; week of thinking can be read back as a diff. Commits happen while Emacs
;; is idle and when it exits; SPC n g commits on demand.

(defvar +notes-gitignore
  '("# Emacs"
    "*~"
    "\\#*\\#"
    ".\\#*"
    ""
    "# Regenerated by org"
    ".orgids"
    ""
    "# Drawn from the org files"
    "notes/maps/*.png"
    "notes/maps/*.pdf"
    "notes/maps/*.svg"
    ""
    "# Agent scratch space"
    ".agent-shell/")
  "Lines written into the notes repository's .gitignore.")

(declare-function +notes--watch "../config")
(declare-function magit-status-setup-buffer "magit-status")
(declare-function org-roam-db-sync "org-roam-db")

(defun +notes--git (&rest args)
  "Run git with ARGS inside `org-directory', returning (CODE . OUTPUT)."
  (apply #'+core-git org-directory args))

(defun +notes--state ()
  "What git says about the notes: `no-repo', `stopped', `dirty' or `clean'.
The one state every command below branches on."
  (+core-git-state org-directory))

;;;###autoload
(defun +notes-repo-p ()
  "Non-nil when the notes are versioned; .git is a file in a worktree."
  (file-exists-p (expand-file-name ".git" org-directory)))

(defun +notes--stopped-message ()
  "The line that tells the user a rebase or merge is waiting."
  (format "A rebase or merge is stopped in %s, finish it in magit (SPC n SPC H)"
          (abbreviate-file-name org-directory)))

(defun +notes--message ()
  "A commit message: the date and time."
  (format-time-string "notes: %Y-%m-%d %H:%M"))

;;;###autoload
(defun +notes/init-repo ()
  "Turn the notes into a git repository and commit what is there.
Everything after this is recoverable, which is the point of writing things
down in the first place."
  (interactive)
  (require 'org)
  (+notes--ensure-directories)
  (cond
   ((+notes-repo-p)
    (message "%s is already a repository" (abbreviate-file-name org-directory)))
   ((not (zerop (car (+notes--git "config" "user.email"))))
    (user-error "git has no identity here: git config --global user.email"))
   (t
    (let ((ignore (expand-file-name ".gitignore" org-directory)))
      (+notes--git "init" "-q" "-b" "main")
      (unless (file-exists-p ignore)
        (with-temp-file ignore
          (insert (string-join +notes-gitignore "\n") "\n")))
      (+notes--git "add" "-A")
      (+notes--git "commit" "-q" "-m" "notes: the tree as it stands")
      (+notes--watch)
      (message "%s is now a repository, SPC n g commits it"
               (abbreviate-file-name org-directory))))))

;;;###autoload
(defun +notes/commit (&optional message)
  "Commit the notes with MESSAGE, or a timestamp when none is given."
  (interactive
   (list (and (eq (+notes--state) 'dirty)
              (read-string "Message: " (+notes--message)))))
  (pcase (+notes--state)
    ('no-repo
     (user-error "%s is not a repository, run +notes/init-repo"
                 (abbreviate-file-name org-directory)))
    ('stopped (user-error "%s" (+notes--stopped-message)))
    ('clean (message "Nothing to commit in %s"
                     (abbreviate-file-name org-directory)))
    ('dirty
     (+notes--git "add" "-A")
     (let ((result (+notes--git "commit" "-q" "-m"
                                    (or message (+notes--message)))))
       (if (zerop (car result))
           (message "Notes committed")
         (message "git said: %s" (cdr result)))))))

;;;###autoload
(defun +notes--autocommit ()
  "Commit the notes quietly, for the idle timer and for `kill-emacs-hook'.
Returns t when nothing is left to commit afterwards, nil when something
is: a stopped rebase, or a commit that failed (no git identity, a stale
index.lock), which is reported rather than swallowed."
  (pcase (+notes--state)
    ((or 'no-repo 'clean) t)
    ('stopped nil)
    ('dirty
     (+notes--git "add" "-A")
     (let ((result (+notes--git "commit" "-q" "-m" (+notes--message))))
       (if (zerop (car result))
           t
         (message "Notes not committed, git said: %s" (cdr result))
         nil)))))

(defvar +notes--sync-process nil
  "The pull or push running for `+notes/sync', so a second sync waits.")

(defun +notes--run (args on-success)
  "Run git ARGS in the notes in the background; call ON-SUCCESS with the
output when it exits 0, message the output otherwise.  Prompts are off,
so a password or an unknown host fails instead of hanging Emacs, and an
unreachable host is given ten seconds."
  (let* ((default-directory (file-name-as-directory (expand-file-name org-directory)))
         (process-environment
          (append '("GIT_TERMINAL_PROMPT=0"
                    "GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=10")
                  process-environment))
         (buffer (generate-new-buffer " *notes git*")))
    (setq +notes--sync-process
          (make-process
           :name "notes-git" :buffer buffer :noquery t
           :command (cons "git" args)
           :sentinel
           (lambda (process event)
             (when (memq (process-status process) '(exit signal))
               (let ((output (with-current-buffer buffer
                               (string-trim (buffer-string))))
                     (code (process-exit-status process)))
                 (kill-buffer buffer)
                 (setq +notes--sync-process nil)
                 (cond ((zerop code) (funcall on-success output))
                       ((eq (+notes--state) 'stopped)
                        (message "%s: %s" (+notes--stopped-message)
                                 (car (last (split-string output "\n" t)))))
                       (t (message "git %s failed: %s" (car args)
                                   (if (string-empty-p output)
                                       (string-trim event)
                                     (car (split-string output "\n" t)))))))))))))

;;;###autoload
(defun +notes/sync ()
  "Commit the notes, then pull and push them, in the background.
Run it before and after working on another machine.  Only the files
travel: the org-roam database is a cache each machine builds for itself,
so there is nothing to conflict over; it is rebuilt after the pull, so
the finder knows the notes that arrived."
  (interactive)
  (when (and +notes--sync-process
             (process-live-p +notes--sync-process))
    (user-error "A sync is still running"))
  (pcase (+notes--state)
    ('no-repo
     (user-error "%s is not a repository, run +notes/init-repo"
                 (abbreviate-file-name org-directory)))
    ('stopped (user-error "%s" (+notes--stopped-message))))
  ;; Pulling over uncommitted changes would stash them; stop instead.
  (unless (+notes--autocommit)
    (user-error "The notes did not commit, nothing was pulled"))
  (when (string-empty-p (cdr (+notes--git "remote")))
    (user-error "No remote yet: git remote add origin <url> in %s"
                (abbreviate-file-name org-directory)))
  (message "Syncing the notes...")
  (+notes--run
   '("pull" "--rebase")
   (lambda (_)
     ;; What the other machine wrote is on disk now, and the graph's
     ;; database learns of a file only when it is visited: read them all.
     ;; If that fails it is the graph that is behind, not the notes, and
     ;; the push still has to happen: a sentinel that dies here would
     ;; leave the commits here and say nothing.
     (let ((trouble (when (featurep 'org-roam)
                      (condition-case err
                          (progn (org-roam-db-sync) nil)
                        (error (error-message-string err))))))
       (+notes--run
        '("push")
        (lambda (_)
          (if trouble
              (message "Notes pushed; the graph was not rebuilt: %s" trouble)
            (message "Notes synced, the graph is up to date"))))))))

;;;###autoload
(defun +notes/log ()
  "Show what changed in the notes lately."
  (interactive)
  (unless (+notes-repo-p)
    (user-error "%s is not a repository" (abbreviate-file-name org-directory)))
  (if (fboundp 'magit-status)
      (magit-status-setup-buffer (expand-file-name org-directory))
    (message "%s" (cdr (+notes--git "log" "--oneline" "-20")))))
