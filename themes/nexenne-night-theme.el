;;; nexenne-night-theme.el -*- lexical-binding: t; no-byte-compile: t; -*-
;;
;; Nexenne by night: warm charcoal, distinct calm colours, for reading and writing code.
;;
;; Copyright (C) 2026 Nicolò Plebani. All rights reserved.
;;
;; Nexenne, a pair for long hours of reading and writing code:
;; nexenne-day when the system is light, nexenne-night when it is dark.
;; Each kind of token has its own colour, set so that any two stay easy
;; to tell apart, also with red-green colour blindness; text is strong
;; but not maximal, comments quieter, and there is no pure white or pure
;; black. Function definitions are bold, to find them at a glance.
;; Written by bin/nexenne-palette: change colours there.

(deftheme nexenne-night
  "Nexenne by night: warm charcoal, distinct calm colours, for reading and writing code."
  :background-mode 'dark
  :kind 'color-scheme
  :family 'nexenne)

