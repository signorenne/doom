            ('package-mark-delete-line', dict(bg='del_bg', extend=True)), ('package-mark-install-line', dict(bg='add_bg', extend=True)),
            ('persp-face-lighter-buffer-not-in-persp', dict(fg='red')),
            ('reb-match-0', dict(bg='search', fg='fg')), ('reb-match-1', dict(bg='chg_hi', fg='fg')),
            ('reb-match-2', dict(bg='add_hi', fg='fg')), ('reb-match-3', dict(bg='del_hi', fg='fg')),
