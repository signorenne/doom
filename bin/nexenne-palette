"""Write the nexenne themes, themes/nexenne-day-theme.el and
themes/nexenne-night-theme.el, delta's .tmTheme beside each, and print
every text colour's contrast on its background.

  bin/nexenne-palette

Every colour is a lightness, a chroma and a hue in OKLCH. Change those
numbers here, never a hex in the theme files, then read the table again:
text should stay near Lc 90, the syntax colours at 68 or more, comments
near 55 to 67.
"""
import math, os
THEMES = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'themes')
YEAR = 2026
AUTHOR = 'Nicolò Plebani'


def oklch_to_srgb(L, C, h):
    a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
    l_ = L + 0.3963377774 * a + 0.2158037573 * b
    m_ = L - 0.1055613458 * a - 0.0638541728 * b
    s_ = L - 0.0894841775 * a - 1.2914855480 * b
    l, m, s = l_ ** 3, m_ ** 3, s_ ** 3
    r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
    g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
    bb = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    f = lambda x: 12.92 * x if x <= 0.0031308 else 1.055 * x ** (1 / 2.4) - 0.055
    return tuple(min(1, max(0, f(c))) for c in (r, g, bb))


def hexc(rgb): return '#%02x%02x%02x' % tuple(round(c * 255) for c in rgb)
def lin(c): return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def wcag(fg, bg):
    Y = lambda rgb: 0.2126 * lin(rgb[0]) + 0.7152 * lin(rgb[1]) + 0.0722 * lin(rgb[2])
    a, b = Y(fg), Y(bg)
    return (max(a, b) + 0.05) / (min(a, b) + 0.05)


def apca(fg, bg):
    Y = lambda rgb: 0.2126729 * rgb[0] ** 2.4 + 0.7151522 * rgb[1] ** 2.4 + 0.0721750 * rgb[2] ** 2.4
    t, b = Y(fg), Y(bg)
    clamp = lambda y: y if y > 0.022 else y + (0.022 - y) ** 1.414
    t, b = clamp(t), clamp(b)
    if abs(b - t) < 0.0005: return 0
    if b > t:
        c = (b ** 0.56 - t ** 0.57) * 1.14
        return 0 if c < 0.1 else (c - 0.027) * 100
    c = (b ** 0.65 - t ** 0.62) * 1.14
    return 0 if c > -0.1 else (c + 0.027) * 100


P = lambda L, C, h: hexc(oklch_to_srgb(L, C, h))

# Accents for the interface: errors, diffs, headings, terminals.
H = dict(red=22, orange=50, yellow=85, green=128, teal=178, blue=238, violet=305, magenta=355)

# The syntax: a hue for each kind of token, and its lightness and chroma
# by night and by day, chosen so any two kinds stay apart, also with
# red-green colour blindness, and each reads well on its background.
ROLES = dict(keyword=(308, .830, .130, .514, .126), function=(236, .890, .130, .468, .084),
             type=(172, .852, .124, .468, .076), string=(120, .813, .094, .521, .121),
             constant=(39, .876, .104, .463, .091), builtin=(344, .817, .050, .412, .080),
             property=(95, .890, .105, .408, .074))


def palette(dark):
    """Every colour of one theme, by name."""
    if dark:
        w, n, a, ac = 70, .010, .855, .068
        g = dict(bg=P(.215, n, w), bg_alt=P(.245, n, w), bg_raised=P(.255, n, w), bg_low=P(.235, n, w),
                 border=P(.275, n, w), faint=P(.52, n, w), dim=P(.68, n, w), comment=P(.745, .012, w),
                 doc=P(.80, .014, w), fg=P(.925, .012, w), fg_strong=P(.96, .010, w),
                 region=P(.34, .035, 250), search=P(.42, .07, 45), copper=P(a - .03, ac + .03, 45),
                 add_bg=P(.30, .05, 140), del_bg=P(.30, .05, 25), chg_bg=P(.30, .04, 85),
                 add_hi=P(.37, .07, 140), del_hi=P(.37, .07, 25), chg_hi=P(.37, .06, 85),
                 add_ref=P(.45, .10, 140), del_ref=P(.45, .10, 25), chg_ref=P(.45, .09, 85),
                 ansi_black=P(.40, n, w), ansi_white=P(.925, .012, w))
        bright = .06
    else:
        w, n, a, ac = 85, .012, .475, .105
        g = dict(bg=P(.958, n, w), bg_alt=P(.935, n, w), bg_raised=P(.925, n, w), bg_low=P(.945, n, w),
                 border=P(.88, n, w), faint=P(.68, n, w), dim=P(.56, n, w), comment=P(.535, .012, w),
                 doc=P(.47, .014, w), fg=P(.325, .012, w), fg_strong=P(.25, .012, w),
                 region=P(.90, .03, 250), search=P(.85, .06, 45), copper=P(a + .02, ac + .03, 45),
                 add_bg=P(.92, .04, 140), del_bg=P(.91, .04, 25), chg_bg=P(.92, .04, 85),
                 add_hi=P(.86, .07, 140), del_hi=P(.85, .07, 25), chg_hi=P(.86, .06, 85),
                 add_ref=P(.79, .10, 140), del_ref=P(.78, .10, 25), chg_ref=P(.79, .09, 85),
                 ansi_black=P(.325, .012, w), ansi_white=P(.80, n, w))
        bright = -.06
    for k, h in H.items():
        g[k] = P(a, ac, h)
        g[k + '_bright'] = P(a + bright, ac, h)
    for k, (h, ln, cn, ld, cd) in ROLES.items():
        g['syn_' + k] = P(ln, cn, h) if dark else P(ld, cd, h)
    return g


