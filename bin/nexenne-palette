            ('treemacs-peek-mode-indicator-face', dict(bg='syn_type')),
            ('tty-menu-disabled-face', dict(bg='bg_raised', fg='dim')), ('tty-menu-enabled-face', dict(bg='bg_raised', fg='fg')),
            ('tty-menu-selected-face', dict(bg='region', fg='fg_strong')),
            ('wgrep-face', dict(bg='chg_bg', fg='fg')), ('wgrep-delete-face', dict(bg='del_bg', fg='red', strike_through=True)),
            ('wgrep-done-face', dict(fg='green')), ('wgrep-file-face', dict(bg='bg_alt', fg='fg')),
            ('wgrep-reject-face', dict(fg='red', weight='bold')),
            ('log-view-file', dict(fg='syn_function', weight='bold')), ('log-view-message', dict(fg='syn_keyword')),
            ('log-view-commit-body', dict(fg='fg')),
            ('which-func', dict(fg='syn_function')), ('whitespace-hspace', dict(fg='border'))):
        f(face, **kw)
    return F


def lisp_face(face, kw, g):
    attrs = []
    keymap = dict(fg=':foreground', bg=':background', weight=':weight', slant=':slant', underline=':underline',
                  extend=':extend', inherit=':inherit', height=':height', box=':box', strike_through=':strike-through')
    for k, v in kw.items():
        # A chip, text in the background's colour on a colour of its own,
        # is that colour drawn inverse. hl-line's overlay sets the
        # current line's background over the text's, which took a chip's
        # colour away; inverse, that background becomes its text instead.
        if k == 'chip':
            attrs.append(f':foreground "{g[v]}" :inverse-video t')
            continue
        key = keymap[k]
        if k in ('fg', 'bg'):
            attrs.append(f'{key} "{g[v]}"')
        elif k in ('inherit', 'weight', 'slant'):
            attrs.append(f"{key} {v}")
        elif k == 'underline' and isinstance(v, tuple):
            attrs.append(f'{key} (:style {v[0]} :color "{g[v[1]]}")')
        elif k == 'box':
            attrs.append(f'{key} (:line-width (1 . -1) :color "{g["border"]}")')
        elif v is True:
            attrs.append(f'{key} t')
        elif k == 'strike_through':
            attrs.append(f'{key} t')
        else:
            attrs.append(f'{key} {v}')
    return f"   '({face} ((t ({' '.join(attrs)}))))"


def write(name, dark, doc):
    g = palette(dark)
    mode = 'dark' if dark else 'light'
    body = '\n'.join(lisp_face(face, kw, g) for face, kw in faces(dark))
    text = f''';;; {name}-theme.el -*- lexical-binding: t; no-byte-compile: t; -*-
;;
;; {doc}
;;
;; Copyright (C) {YEAR} {AUTHOR}. All rights reserved.
;;
;; Nexenne, a pair for long hours of reading and writing code:
;; nexenne-day when the system is light, nexenne-night when it is dark.
;; Each kind of token has its own colour, set so that any two stay easy
;; to tell apart, also with red-green colour blindness; text is strong
;; but not maximal, comments quieter, and there is no pure white or pure
;; black. Function definitions are bold, to find them at a glance.
;; Written by bin/nexenne-palette: change colours there.

(deftheme {name}
  "{doc}"
  :background-mode '{mode}
  :kind 'color-scheme
  :family 'nexenne)

(custom-theme-set-faces
 '{name}
{body})

(provide-theme '{name})

;;; {name}-theme.el ends here
'''
    open(os.path.join(THEMES, f'{name}-theme.el'), 'w').write(text)
    return g


# The same roles for delta, which colours code in diffs from a TextMate
# theme: scope, palette colour, font style.
TM_SCOPES = [
    ('comment, punctuation.definition.comment', 'comment', 'italic'),
    ('string, punctuation.definition.string', 'syn_string', ''),
    ('constant.numeric, constant.language, constant.character, constant.other', 'syn_constant', ''),
    ('constant.character.escape', 'syn_constant', 'bold'),
    ('keyword, storage.modifier, keyword.control', 'syn_keyword', ''),
    ('keyword.operator', 'fg', ''),
    ('storage.type, entity.name.type, entity.name.class, entity.name.struct, '
     'entity.name.enum, support.type, support.class', 'syn_type', ''),
    ('entity.name.function', 'syn_function', 'bold'),
    ('support.function, meta.function-call, variable.function', 'syn_function', ''),
    ('support.constant, variable.language, meta.preprocessor, keyword.control.directive', 'syn_builtin', ''),
    ('variable.other.member, variable.other.property, support.variable.property, '
     'entity.other.attribute-name, meta.object-literal.key', 'syn_property', ''),
    ('entity.name.tag', 'syn_function', ''),
    ('punctuation, meta.brace', 'dim', ''),
    ('markup.heading, entity.name.section', 'syn_function', 'bold'),
    ('markup.bold', 'fg_strong', 'bold'),
    ('markup.italic', 'fg', 'italic'),
    ('markup.raw, markup.inline.raw', 'syn_string', ''),
    ('markup.underline.link', 'blue', 'underline'),
    ('invalid', 'red', 'bold'),
]


def write_tmtheme(name, g):
    def entry(scope, color, style):
        style = f'<key>fontStyle</key><string>{style}</string>' if style else ''
        return (f'<dict><key>scope</key><string>{scope}</string><key>settings</key>'
                f'<dict><key>foreground</key><string>{g[color]}</string>{style}</dict></dict>')
    rules = '\n'.join(entry(*rule) for rule in TM_SCOPES)
    text = f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {name}: delta's colours for code, from bin/nexenne-palette.
     Copyright (C) {YEAR} {AUTHOR}. All rights reserved. -->
<plist version="1.0"><dict>
<key>name</key><string>{name}</string>
<key>settings</key><array>
<dict><key>settings</key><dict><key>background</key><string>{g['bg']}</string><key>foreground</key><string>{g['fg']}</string></dict></dict>
{rules}
</array></dict></plist>
'''
    open(os.path.join(THEMES, f'{name}.tmTheme'), 'w').write(text)


def report(name, g):
    bg = tuple(int(g['bg'][i:i + 2], 16) / 255 for i in (1, 3, 5))
    print(f"== {name}  background {g['bg']}")
    for k in ['fg', 'comment', 'doc', 'dim'] + ['syn_' + r for r in ROLES] + list(H) + ['copper']:
        c = tuple(int(g[k][i:i + 2], 16) / 255 for i in (1, 3, 5))
        print(f"  {k:12} {g[k]}  APCA Lc {apca(c, bg):6.1f}  WCAG {wcag(c, bg):5.2f}:1")


if __name__ == '__main__':
    night = write('nexenne-night', True,
                  'Nexenne by night: warm charcoal, distinct calm colours, for reading and writing code.')
    day = write('nexenne-day', False,
                'Nexenne by day: warm paper, distinct calm colours, for reading and writing code.')
    write_tmtheme('nexenne-night', night)
    write_tmtheme('nexenne-day', day)
    report('nexenne-night', night)
    report('nexenne-day', day)
