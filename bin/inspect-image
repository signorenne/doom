#!/usr/bin/env python3
"""Describe an image file from the inside: what it is, how it is built,
what it says about itself, and its first bytes.

    inspect-image FILE

Four sections, each title at the margin and its lines indented under it:
the picture, its structure (the format's own chunks or markers, with
offsets and lengths), its metadata, and the first 256 bytes in hex. A
file that is cut off or damaged is described as far as it goes, and the
place it stops is said, rather than the whole report failing.

Emacs shows this beside an image; it is run over every image on the
machine to catch a file it cannot describe before it reaches the editor.

    inspect-image --svg < DRAWING

describes an SVG read on standard input, as the editor has it, saved or
not: its size, what it is made of, its ids, what it embeds and the fonts
it names, or where it stops being well formed.
"""

import os
import struct
import subprocess
import sys
import urllib.parse
import warnings
import zlib

# PIL warns on stderr about oddities it then reads past, an icon of an
# unexpected size; in the editor that would print into the report.
warnings.simplefilter("ignore")

W = 8  # width of the offset column


def human(n):
    return f"{n:,}".replace(",", " ")


def row(offset, length, name, detail=""):
    off = "" if offset is None else str(offset)
    ln = "" if length is None else human(length)
    return f"  {off:>{W}}  {ln:>9}  {name:<6} {detail}".rstrip()


def header():
    return f"  {'offset':>{W}}  {'length':>9}  {'part':<6} what it holds"


# PNG

PNG_COLOUR = {0: "grey", 2: "RGB", 3: "palette", 4: "grey with alpha", 6: "RGBA"}


def png(data):
    out = [header(), row(0, 8, "sig", "89 50 4E 47 0D 0A 1A 0A, the PNG signature")]
    i, n = 8, len(data)
    idat_count = idat_bytes = 0
    idat_first = None
    while i + 8 <= n:
        length, kind = struct.unpack(">I4s", data[i:i + 8])
        kind = kind.decode("latin-1")
        body = data[i + 8:i + 8 + length]
        if len(body) < length:
            out.append(row(i, length, kind, f"cut off: {len(body)} of {human(length)} bytes present"))
            return out
        crc_ok = len(data) >= i + 12 + length and \
            struct.unpack(">I", data[i + 8 + length:i + 12 + length])[0] == zlib.crc32(data[i + 4:i + 8 + length]) & 0xFFFFFFFF
        bad = "" if crc_ok else ", CRC does not match"
        if kind == "IDAT":
            idat_count += 1
            idat_bytes += length
            idat_first = i if idat_first is None else idat_first
        else:
            if idat_count:
                out.append(row(idat_first, idat_bytes, "IDAT",
                               f"{idat_count} chunk{'s' * (idat_count > 1)} of compressed pixels"))
                idat_count = idat_bytes = 0
                idat_first = None
            out.append(row(i, length, kind, png_detail(kind, body) + bad))
        i += 12 + length
        if kind == "IEND":
            if i < n:
                out.append(row(i, n - i, "extra", "bytes after IEND, which no reader looks at"))
            return out
    if idat_count:
        out.append(row(idat_first, idat_bytes, "IDAT", f"{idat_count} chunks of compressed pixels"))
    out.append(row(i, None, "", "no IEND: the file stops before its end marker"))
    return out


def png_detail(kind, body):
    try:
        if kind == "IHDR":
            w, h, depth, colour, comp, filt, lace = struct.unpack(">IIBBBBB", body[:13])
            return (f"{w} x {h}, {depth}-bit {PNG_COLOUR.get(colour, f'colour type {colour}')}, "
                    f"{'Adam7 interlaced' if lace else 'not interlaced'}")
        if kind == "pHYs":
            x, y, unit = struct.unpack(">IIB", body[:9])
            return f"{x} x {y} per metre, {round(x * 0.0254)} dpi" if unit == 1 else f"{x}:{y} aspect"
        if kind in ("tEXt", "zTXt", "iTXt"):
            key = body.split(b"\0", 1)[0].decode("latin-1")
            return f"text: {key}"
        if kind == "iCCP":
            return "colour profile: " + body.split(b"\0", 1)[0].decode("latin-1")
        if kind == "gAMA":
            return f"gamma {struct.unpack('>I', body[:4])[0] / 100000:.5f}"
        if kind == "sRGB":
            return "sRGB colour space"
        if kind == "PLTE":
            return f"palette of {len(body) // 3} colours"
        if kind == "tRNS":
            return "transparency"
        if kind == "tIME":
            y, mo, d, hh, mi, ss = struct.unpack(">HBBBBB", body[:7])
            return f"last changed {y:04}-{mo:02}-{d:02} {hh:02}:{mi:02}:{ss:02}"
        if kind == "eXIf":
            return "EXIF metadata"
        if kind == "acTL":
            frames, plays = struct.unpack(">II", body[:8])
            return f"animated: {frames} frames, {'looping' if plays == 0 else f'{plays} plays'}"
    except struct.error:
        return "too short to read"
    return ""


# JPEG

JPEG_MARKERS = {0xD8: "SOI", 0xD9: "EOI", 0xDA: "SOS", 0xDB: "DQT", 0xC4: "DHT",
                0xDD: "DRI", 0xFE: "COM"}
SOF = {0xC0: "baseline", 0xC1: "extended", 0xC2: "progressive", 0xC3: "lossless"}


def jpeg(data):
    out = [header(), row(0, 2, "SOI", "FF D8, start of image")]
    i, n = 2, len(data)
    # Two bytes are enough to read a marker; EOI is exactly two, and the
    # last two in the file, so asking for four here skips it every time.
    while i + 2 <= n:
        if data[i] != 0xFF:
            out.append(row(i, None, "", f"expected a marker, found {data[i]:02X}: the structure breaks here"))
            return out
        m = data[i + 1]
        if m == 0xFF:  # fill byte
            i += 1
            continue
        if m == 0xD9:
            out.append(row(i, 2, "EOI", "FF D9, end of image"))
            if i + 2 < n:
                out.append(row(i + 2, n - i - 2, "extra", "bytes after the end, which no reader looks at"))
            return out
        if 0xD0 <= m <= 0xD7:
            i += 2
            continue
        if i + 4 > n:
            out.append(row(i, None, f"FF{m:02X}", "cut off before its length"))
            return out
        length = struct.unpack(">H", data[i + 2:i + 4])[0]
        body = data[i + 4:i + 2 + length]
        name = JPEG_MARKERS.get(m, f"APP{m - 0xE0}" if 0xE0 <= m <= 0xEF else
                                f"SOF{m - 0xC0}" if 0xC0 <= m <= 0xCF else f"FF{m:02X}")
        out.append(row(i, length + 2, name, jpeg_detail(m, body)))
        i += 2 + length
        if m == 0xDA:  # scan data runs to the next marker that is not a restart
            start = i
            while i + 1 < n and not (data[i] == 0xFF and data[i + 1] not in (0x00, *range(0xD0, 0xD8))):
                i += 1
            out.append(row(start, i - start, "scan", "compressed pixels"))
    out.append(row(i, None, "", "no EOI: the file stops before its end marker"))
    return out


def jpeg_detail(m, body):
    try:
        if 0xE0 <= m <= 0xEF:
            ident = body.split(b"\0", 1)[0][:30].decode("latin-1", "replace")
            known = {"JFIF": "JFIF header", "Exif": "EXIF metadata", "http://ns.adobe.com/xap/1.0/": "XMP metadata",
                     "ICC_PROFILE": "colour profile", "Adobe": "Adobe colour transform",
                     "MPF": "multi-picture index", "Photoshop 3.0": "Photoshop resources"}
            return known.get(ident, ident or "application data")
        if m in SOF or 0xC0 <= m <= 0xCF and m not in (0xC4, 0xC8, 0xCC):
            prec, h, w, comps = struct.unpack(">BHHB", body[:6])
            return (f"{w} x {h}, {SOF.get(m, 'frame')}, {prec}-bit, "
                    f"{comps} component{'s' * (comps != 1)}")
        if m == 0xDB:
            return "quantisation tables"
        if m == 0xC4:
            return "Huffman tables"
        if m == 0xDA:
            return f"start of scan, {body[0]} component{'s' * (body[0] != 1)}"
        if m == 0xDD:
            return f"restart every {struct.unpack('>H', body[:2])[0]} blocks"
        if m == 0xFE:
            return "comment: " + body[:40].decode("latin-1", "replace")
    except (struct.error, IndexError):
        return "too short to read"
    return ""


# GIF

def gif(data):
    out = [header()]
    version = data[:6].decode("latin-1")
    w, h, flags = struct.unpack("<HHB", data[6:11])
    out.append(row(0, 6, "sig", f"{version}"))
    table = 3 * (2 << (flags & 7)) if flags & 0x80 else 0
    out.append(row(6, 7, "screen", f"{w} x {h}" + (f", global palette of {table // 3} colours" if table else "")))
    i = 13 + table
    frames = 0
    n = len(data)
    while i < n:
        b = data[i]
        if b == 0x3B:
            out.append(row(i, 1, "end", "trailer"))
            break
        if b == 0x21:
            label = data[i + 1]
            j = i + 2
            while j < n and data[j]:
                j += data[j] + 1
            name = {0xF9: "graphic control", 0xFF: "application", 0xFE: "comment", 0x01: "plain text"}.get(label, "extension")
            if label == 0xFF:
                name += ": " + data[i + 3:i + 14].decode("latin-1", "replace")
            if label == 0xF9 and i + 7 < n:
                # The next frame's delay, what is left of it after, and
                # whether a colour in it is see-through.
                gflags, delay = data[i + 3], struct.unpack("<H", data[i + 4:i + 6])[0]
                disposal = {0: "", 1: ", kept", 2: ", cleared to the background",
                            3: ", put back"}.get((gflags >> 2) & 7, "")
                name += f": {delay * 10} ms{disposal}" + (", transparent" if gflags & 1 else "")
            if frames < 8:
                out.append(row(i, j + 1 - i, "ext", name))
            i = j + 1
        elif b == 0x2C:
            fw, fh, fflags = struct.unpack("<4xHHB", data[i + 1:i + 10])
            local = 3 * (2 << (fflags & 7)) if fflags & 0x80 else 0
            j = i + 10 + local + 1
            while j < n and data[j]:
                j += data[j] + 1
            frames += 1
            if frames <= 8:
                out.append(row(i, j + 1 - i, "frame", f"{fw} x {fh}" + (", own palette" if local else "")))
            i = j + 1
        else:
            out.append(row(i, None, "", f"unexpected byte {b:02X}: the structure breaks here"))
            break
    if frames > 8:
        out.append(row(None, None, "", f"... {frames} frames in all"))
    return out


# WebP

def webp(data):
    out = [header(), row(0, 12, "RIFF", f"WebP, {human(struct.unpack('<I', data[4:8])[0])} bytes declared")]
    i, n = 12, len(data)
    while i + 8 <= n:
        kind = data[i:i + 4].decode("latin-1")
        length = struct.unpack("<I", data[i + 4:i + 8])[0]
        detail = {"VP8 ": "lossy pixels", "VP8L": "lossless pixels", "ALPH": "alpha channel",
                  "ANIM": "animation", "ANMF": "animation frame", "ICCP": "colour profile",
                  "EXIF": "EXIF metadata", "XMP ": "XMP metadata"}.get(kind, "")
        if kind == "VP8X":
            flags = data[i + 8]
            w = int.from_bytes(data[i + 12:i + 15], "little") + 1
            h = int.from_bytes(data[i + 15:i + 18], "little") + 1
            parts = [p for bit, p in ((0x10, "alpha"), (0x02, "animation"), (0x20, "colour profile"),
                                      (0x08, "EXIF"), (0x04, "XMP")) if flags & bit]
            detail = f"{w} x {h}" + (", " + ", ".join(parts) if parts else "")
        out.append(row(i, length + 8, kind.strip(), detail))
        i += 8 + length + (length & 1)
    return out


# BMP and ICO

def bmp(data):
    size, offset, dib = struct.unpack("<2xI4xII", data[:18])
    out = [header(), row(0, 14, "file", f"{human(size)} bytes declared, pixels start at {offset}")]
    if dib >= 40:
        w, h, planes, bpp, comp = struct.unpack("<iiHHI", data[18:34])
        kinds = {0: "uncompressed", 1: "RLE 8", 2: "RLE 4", 3: "bit fields", 4: "JPEG", 5: "PNG"}
        out.append(row(14, dib, "DIB", f"{w} x {abs(h)}, {bpp}-bit, {kinds.get(comp, comp)}"
                                        + (", stored top down" if h < 0 else "")))
    else:
        out.append(row(14, dib, "DIB", "an old header"))
    out.append(row(offset, len(data) - offset, "pixels", ""))
    return out


def ico(data):
    count = struct.unpack("<H", data[4:6])[0]
    out = [header(), row(0, 6, "head", f"{count} image{'s' * (count != 1)}")]
    for k in range(count):
        e = data[6 + 16 * k:22 + 16 * k]
        w, h, _, _, _, bpp, size, off = struct.unpack("<BBBBHHII", e)
        inner = "PNG" if data[off:off + 4] == b"\x89PNG" else "BMP"
        out.append(row(off, size, "image", f"{w or 256} x {h or 256}, {bpp}-bit, {inner}"))
    return out


def structure(data):
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return png(data)
    if data.startswith(b"\xff\xd8"):
        return jpeg(data)
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return gif(data)
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return webp(data)
    if data[:2] == b"BM":
        return bmp(data)
    if data[:4] == b"\0\0\1\0":
        return ico(data)
    if data[4:8] == b"ftyp" or data.startswith(b"\0\0\0\x0cJXL \r\n\x87\n"):
        return bmff(data)
    if data.startswith(b"\xff\x0a"):
        return [header(), row(0, len(data), "jxl", "a bare JPEG XL codestream, no boxes around it")]
    if data[:4] == b"8BPS":
        return psd(data)
    return ["  no walk for this format; the metadata and the bytes below still apply"]


# HEIC, HEIF, AVIF and JPEG XL: boxes, as in an MP4

BOX = {"ftyp": "file type", "meta": "metadata", "mdat": "the pixels", "hdlr": "handler",
       "pitm": "primary item", "iinf": "items", "iloc": "where items lie", "iprp": "properties",
       "ipco": "property list", "ipma": "which item has which", "iref": "item references",
       "idat": "item data", "ispe": "size", "hvcC": "HEVC setup", "av1C": "AV1 setup",
       "colr": "colour", "pixi": "channels", "irot": "rotation", "imir": "mirror",
       "clap": "crop", "auxC": "auxiliary", "JXL ": "JPEG XL signature", "jxlc": "codestream",
       "jxlp": "codestream part", "jxll": "level", "Exif": "EXIF", "xml ": "XMP",
       "jbrd": "JPEG to rebuild", "brob": "compressed metadata", "dinf": "data information", "grpl": "groups"}


def boxes(data, start, end):
    """Each box in data[start:end]: (offset, length, type, body start)."""
    i = start
    while i + 8 <= end:
        size, kind = struct.unpack(">I4s", data[i:i + 8])
        head = 8
        if size == 1 and i + 16 <= end:
            size, head = struct.unpack(">Q", data[i + 8:i + 16])[0], 16
        elif size == 0:
            size = end - i
        if size < head:
            yield i, None, None, None
            return
        yield i, size, kind.decode("latin-1", "replace"), i + head
        i += size


def bmff(data):
    out = [header()]
    count = 0

    def walk(start, end, depth):
        nonlocal count
        for off, size, kind, body in boxes(data, start, end):
            if size is None:
                out.append(row(off, None, "", "a box too short: the structure breaks here"))
                return
            count += 1
            if off + size > end:
                out.append(row(off, size, (" " * depth + kind)[:6],
                               f"cut off: {human(end - off)} of {human(size)} bytes present"))
                return
            if count > 60:
                continue
            detail = BOX.get(kind, "")
            if kind == "ftyp":
                brands = [data[k:k + 4].decode("latin-1") for k in range(body + 8, off + size, 4)]
                detail = f"{data[body:body + 4].decode('latin-1')}, also {' '.join(brands)}"
            elif kind == "ispe" and body + 12 <= off + size:
                w, h = struct.unpack(">II", data[body + 4:body + 12])
                detail = f"size: {w} x {h}"
            out.append(row(off, size, (" " * depth + kind)[:6], detail))
            # meta is a full box, four bytes of version and flags first.
            if kind in ("meta", "iprp", "ipco", "dinf") and depth < 2:
                walk(body + (4 if kind == "meta" else 0), off + size, depth + 1)

    walk(0, len(data), 0)
    if count > 60:
        out.append(row(None, None, "", f"... {count} boxes in all"))
    return out


# PSD: a header and four sections

PSD_MODE = {0: "bitmap", 1: "grey", 2: "indexed", 3: "RGB", 4: "CMYK", 7: "multichannel",
            8: "duotone", 9: "Lab"}


def psd(data):
    version, channels, h, w, depth, mode = struct.unpack(">H6xHIIHH", data[4:26])
    out = [header(), row(0, 26, "header", f"{'PSB' if version == 2 else 'PSD'}, {w} x {h}, "
                                         f"{channels} channels of {depth} bits, "
                                         f"{PSD_MODE.get(mode, mode)}")]
    i = 26
    for name, wide in (("colour mode data", False), ("image resources", False),
                       ("layers and masks", version == 2)):
        if i + 4 > len(data):
            return out + [row(i, None, "", "cut off here")]
        n = struct.unpack(">Q" if wide else ">I", data[i:i + (8 if wide else 4)])[0]
        head = 8 if wide else 4
        if i + head + n > len(data):
            return out + [row(i, head + n, "sect", f"{name}, cut off: "
                              f"{human(len(data) - i)} of {human(head + n)} bytes present")]
        out.append(row(i, head + n, "sect", name))
        i += head + n
    if i + 2 <= len(data):
        how = {0: "raw", 1: "RLE", 2: "ZIP", 3: "ZIP with prediction"}.get(
            struct.unpack(">H", data[i:i + 2])[0], "unknown compression")
        out.append(row(i, len(data) - i, "pixels", f"the merged picture, {how}"))
    return out


BITS = {"1": 1, "L": 8, "P": 8, "LA": 16, "RGB": 24, "RGBA": 32, "CMYK": 32,
        "YCbCr": 24, "I;16": 16, "I": 32, "F": 32, "La": 16, "PA": 16}


def ratio(w, h):
    from math import gcd
    g = gcd(w, h) or 1
    a, b = w // g, h // g
    return f"{a}:{b}" if a < 100 and b < 100 else f"{w / h:.3f}:1"


def picture(path, data):
    lines = [f"  file      {os.path.basename(path)}, {human(len(data))} bytes"]
    try:
        from PIL import Image
        with Image.open(path) as im:
            ext = os.path.splitext(path)[1].lstrip(".").upper()
            named = {"JPG": "JPEG", "TIF": "TIFF"}.get(ext, ext)
            lines.append(f"  format    {im.format}, {im.width} x {im.height}"
                         + (f"  (named .{ext.lower()}, but it is {im.format})"
                            if named and im.format and named != im.format else ""))
            lines.append(f"  shape     {ratio(im.width, im.height)}, "
                         f"{im.width * im.height / 1e6:.2f} megapixels")
            lines.append(f"  pixels    {im.mode}"
                         + (", with alpha" if "A" in im.mode or "transparency" in im.info else ""))
            bits = BITS.get(im.mode)
            if bits:
                raw = im.width * im.height * bits // 8
                lines.append(f"  size      {bits} bits a pixel, {human(raw)} bytes raw, "
                             + (f"compressed {raw / len(data):.1f} times"
                                if len(data) and raw > len(data)
                                else "the file is not smaller"))
            frames = getattr(im, "n_frames", 1)
            if frames > 1:
                delays = []
                for k in range(frames):
                    try:
                        im.seek(k)
                        delays.append(im.info.get("duration", 0) or 0)
                    except EOFError:
                        break
                total = sum(delays)
                loop = im.info.get("loop")
                lines.append(f"  animated  {frames} frames"
                             + (f", {total / 1000:.2f} s" if total else "")
                             + (f", {frames * 1000 / total:.1f} frames a second" if total else "")
                             + (", looping" if loop == 0 else f", {loop} plays" if loop else ""))
                # Each run of equal delays once: "80 ms x 11, 600 ms" says
                # the last frame is held, which a total hides.
                runs = []
                for d in delays:
                    if runs and runs[-1][0] == d:
                        runs[-1][1] += 1
                    else:
                        runs.append([d, 1])
                shown = ", ".join(f"{d} ms" + (f" x {c}" if c > 1 else "") for d, c in runs[:12])
                lines.append(f"  delays    {shown}" + (", ..." if len(runs) > 12 else ""))
            dpi = im.info.get("dpi")
            if dpi:
                lines.append(f"  density   {round(dpi[0])} x {round(dpi[1])} dpi")
            if im.info.get("icc_profile"):
                lines.append("  colour    carries an ICC profile")
    except Exception as e:  # noqa: BLE001 (describe, never fail)
        lines += vips_picture(path) or [f"  format    not readable as a picture: {e}"]
    return lines


def vips_picture(path):
    """The picture as vips reads it, for what PIL cannot open: HEIC, JPEG
    XL. Nothing when vips is missing or cannot read it either."""
    try:
        out = subprocess.run(["vipsheader", "-a", path], capture_output=True,
                             text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    fields = dict(line.split(": ", 1) for line in out.splitlines() if ": " in line)
    if "width" not in fields:
        return []
    w, h = int(fields["width"]), int(fields["height"])
    loader = fields.get("vips-loader", "").replace("load", "").replace("_source", "")
    lines = [f"  format    {loader.upper() or 'unknown'}, {w} x {h}, read by vips",
             f"  shape     {ratio(w, h)}, {w * h / 1e6:.2f} megapixels",
             f"  pixels    {fields.get('bands', '?')} bands, {fields.get('interpretation', '?')}, "
             f"{fields.get('format', '?')}"]
    if fields.get("heif-compression"):
        lines.append(f"  coding    {fields['heif-compression']}")
    if int(fields.get("n-pages", "1") or 1) > 1:
        lines.append(f"  pages     {fields['n-pages']}")
    if "icc-profile-data" in fields:
        lines.append("  colour    carries an ICC profile")
    return lines


BARS = "".join(chr(0x2581 + k) for k in range(8))  # the eight block heights


def spark(hist, buckets=16):
    """HIST, 256 counts, as BUCKETS bars of eight heights."""
    step = len(hist) // buckets
    sums = [sum(hist[k:k + step]) for k in range(0, len(hist), step)][:buckets]
    top = max(sums) or 1
    return "".join(BARS[min(7, int(v * 8 / top))] if v else " " for v in sums)


def scaled_copy(path):
    """The picture at most 512 pixels a side, as PIL, and the size it was.
    What PIL cannot read, HEIC, JPEG XL, a PSD it stumbles on, is scaled
    by vips first."""
    from PIL import Image
    try:
        with Image.open(path) as im:
            im.seek(0)
            small = im.copy()
            small.thumbnail((512, 512))
            return small, im.size
    except Exception:  # noqa: BLE001 (vips may read it)
        import tempfile
        with tempfile.TemporaryDirectory() as tmp:
            out = os.path.join(tmp, "small.png")
            subprocess.run(["vipsthumbnail", path, "--size", "512", "-o", out],
                           capture_output=True, timeout=60, check=True)
            size = tuple(int(subprocess.run(["vipsheader", "-f", f, path], capture_output=True,
                                            text=True, timeout=20).stdout or 0)
                         for f in ("width", "height"))
            with Image.open(out) as im:
                return im.copy(), size


def colours(path):
    """What the pixels are: how many colours, which, how transparent."""
    try:
        from PIL import Image, ImageStat
    except ImportError:
        return ["  python3 has no PIL; openSUSE: zypper in python3-Pillow"]
    try:
        small, size = scaled_copy(path)
        has_alpha = "A" in small.mode or "transparency" in small.info
        rgba = small.convert("RGBA")
    except Exception as e:  # noqa: BLE001
        return [f"  the pixels could not be read: {e}"]
    lines = []
    n = rgba.width * rgba.height or 1
    counted = rgba.getcolors(65536)
    note = " (on a copy scaled to 512)" if (rgba.width, rgba.height) != size else ""
    lines.append(f"  distinct  {human(len(counted))} colours{note}" if counted
                 else f"  distinct  more than 65 536 colours{note}")
    alpha = rgba.getchannel("A")
    ah = alpha.histogram()
    clear, full = ah[0], ah[255]
    if has_alpha and full == n:
        lines.append("  alpha     every pixel is opaque: the alpha channel carries nothing")
    elif has_alpha:
        lines.append(f"  alpha     {100 * clear / n:.1f}% transparent, "
                     f"{100 * (n - clear - full) / n:.1f}% partly, {100 * full / n:.1f}% opaque")
    stat = ImageStat.Stat(rgba.convert("RGB"), mask=alpha if clear < n else None)
    mean = tuple(round(v) for v in stat.mean)
    lines.append("  mean      #%02x%02x%02x" % mean + ("  (over the visible pixels)" if has_alpha else ""))
    try:
        q = rgba.convert("RGB").quantize(colors=6, method=Image.Quantize.MEDIANCUT)
        pal = q.getpalette()
        order = sorted(q.getcolors(), reverse=True)
        tops = ["#%02x%02x%02x %d%%" % (*pal[3 * i:3 * i + 3], round(100 * c / n))
                for c, i in order[:6] if 100 * c / n >= 1]
        lines.append("  dominant  " + "   ".join(tops))
    except Exception:  # noqa: BLE001 (optional)
        pass
    rgb = rgba.convert("RGB")
    ext = rgb.getextrema()
    for band, name in zip(range(3), ("red", "green", "blue")):
        h = rgb.getchannel(band).histogram()
        lines.append(f"  {name:<9} {ext[band][0]:>3} to {ext[band][1]:>3}, mean {stat.mean[band]:5.1f}  {spark(h)}")
    if has_alpha:
        lines.append(f"  {'alpha':<9} {min(v for v in range(256) if ah[v]) if any(ah) else 0:>3} to "
                     f"{max(v for v in range(256) if ah[v]) if any(ah) else 0:>3}              {spark(ah)}")
    return lines


def metadata(path):
    try:
        out = subprocess.run(["exiftool", "-G1", "-s", "-a", path],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ["  exiftool is not installed; openSUSE: zypper in exiftool"]
    lines = []
    for line in out.splitlines():
        # The file system's own facts, permissions and dates, are not the
        # image's; leave them out.
        if line.startswith(("[System]", "[ExifTool]")):
            continue
        group, _, rest = line.partition("]")
        lines.append(f"  {group[1:]:<13} {rest.strip()}")
    return lines or ["  nothing"]


def hexdump(data, count=256):
    lines = []
    for off in range(0, min(count, len(data)), 16):
        chunk = data[off:off + 16]
        hx = " ".join(f"{b:02x}" for b in chunk[:8]) + "  " + " ".join(f"{b:02x}" for b in chunk[8:])
        text = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        lines.append(f"  {off:08x}  {hx:<49} |{text}|")
    return lines


# SVG

def svg_report(text):
    import re
    import xml.etree.ElementTree as ET
    size = len(text.encode("utf-8"))
    lines = [f"  bytes     {human(size)}, {human(text.count(chr(10)) + 1)} lines"]
    try:
        root = ET.fromstring(text)
    except ET.ParseError as e:
        line, col = e.position
        return [("The drawing", lines + [f"  not well formed at line {line}, column {col}: "
                                         + str(e).split(":")[0]])]
    local = lambda tag: tag.rsplit("}", 1)[-1] if isinstance(tag, str) else "?"
    a = root.attrib
    lines.append(f"  size      {a.get('width', 'not given')} x {a.get('height', 'not given')}")
    lines.append(f"  viewBox   {a.get('viewBox', 'none')}")
    counts, ids, embedded, linked, fonts = {}, [], [], [], set()
    for el in root.iter():
        name = local(el.tag)
        counts[name] = counts.get(name, 0) + 1
        if "id" in el.attrib:
            ids.append(f"{el.attrib['id']} ({name})")
        href = next((v for k, v in el.attrib.items() if local(k) == "href"), None)
        if name == "image" and href:
            if href.startswith("data:"):
                # data:[type][;parameters][;base64],payload
                meta, _, payload = href[5:].partition(",")
                kind = meta.split(";", 1)[0]
                size = (len(payload) * 3 // 4 if meta.endswith(";base64")
                        else len(urllib.parse.unquote_to_bytes(payload)))
                embedded.append((kind, size))
            else:
                linked.append(href)
        style = el.attrib.get("style", "") + ";" + (el.text or "" if name == "style" else "")
        for family in [el.attrib.get("font-family")] + re.findall(r"font-family\s*:\s*([^;}]+)", style):
            # A list, first choice first: "Inter", sans-serif names two.
            for one in (family or "").split(","):
                if one.strip().strip("'\""):
                    fonts.add(one.strip().strip("'\""))
    out = [("The drawing", lines)]
    out.append(("Made of", [f"  {n:<16} {human(c)}" for n, c in
                            sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]))
    out.append(("Ids", [f"  {i}" for i in ids[:80]]
                + ([f"  and {human(len(ids) - 80)} more"] if len(ids) > 80 else [])
                or ["  none"]))
    pictures = [f"  {kind or 'unknown'}, about {human(n)} bytes, embedded" for kind, n in embedded]
    pictures += [f"  {h}, linked" for h in linked]
    if embedded:
        pictures.insert(0, f"  {len(embedded)} embedded, about "
                        f"{human(sum(n for _, n in embedded))} bytes in all")
    out.append(("Pictures inside", pictures or ["  none"]))
    out.append(("Fonts named", [f"  {f}" for f in sorted(fonts)] or ["  none"]))
    return out


def main():
    if sys.argv[1:] == ["--svg"]:
        text = sys.stdin.buffer.read().decode("utf-8", "replace")
        print("\n\n".join(title + "\n" + "\n".join(lines) for title, lines in svg_report(text)))
        return
    if len(sys.argv) != 2:
        print("usage: inspect-image FILE, or inspect-image --svg < DRAWING")
        sys.exit(1)
    path = sys.argv[1]
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as e:
        print(f"cannot read {path}: {e.strerror}")
        sys.exit(1)
    sections = [("The picture", picture(path, data)), ("Colours", colours(path))]
    try:
        sections.append(("Structure", structure(data)))
    except Exception as e:  # noqa: BLE001 (a damaged file is described, not fatal)
        sections.append(("Structure", [f"  the structure could not be walked: {e}"]))
    sections.append(("Metadata", metadata(path)))
    # All of a small file; the first kilobyte of a large one.
    count = len(data) if len(data) <= 2048 else 1024
    sections.append(("All the bytes" if count == len(data) else f"The first {human(count)} bytes",
                     hexdump(data, count)))
    print("\n\n".join(title + "\n" + "\n".join(lines) for title, lines in sections))


if __name__ == "__main__":
    main()
