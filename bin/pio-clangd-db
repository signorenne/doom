#!/usr/bin/env python3
"""Write the compilation database clangd reads for a PlatformIO project.

  pio-clangd-db ROOT

ROOT/compile_commands.json is what `pio run -t compiledb` writes: the real
cross compiler's command lines, which clang cannot take as they are. This
writes ROOT/.pio/clangd/compile_commands.json, which Emacs starts clangd
on, with these things changed for every entry and nothing to set up per
project:

- the compiler named in full: pio names most of them bare, an
  xtensa-esp32s3-elf-gcc on no PATH, and clangd then asked no compiler for
  its headers and found not even <sys/features.h>;
- the flags clang does not know taken out, -mlongcalls and the rest of
  GCC's, each an error at the top of every file; clang itself is asked
  which they are, so a new GCC's are found too;
- no system directories for a cross compiler: clangd on macOS gives a
  command without a sysroot the Mac's own, and its <limits.h> stopped
  every file with "architecture not supported". The cross compiler's
  directories, which clangd asks it for, and clang's own headers stay.
  Said to clang's front end, -Xclang -nostdsysteminc: as -nostdlibinc,
  clangd took the command for one without system headers and asked the
  compiler for none, so not even <initializer_list> was found;
- libstdc++ told the C library's isinf and isnan are there, where they
  are: a toolchain whose libstdc++ does not know it declares its own,
  GCC lets the two be, as builtins, and clang does not, so every file
  with Arduino.h in it stopped at its "using std::isinf". The compiler
  itself is asked whether the C library declares them.

The directory .pio is the build's, which git leaves alone.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

ADD = ["-Wno-unknown-warning-option", "-Wno-unknown-attributes",
       "-Wno-ignored-optimization-argument"]

# What clang is not asked about: it knows them, but they only rename
# paths in diagnostics and confuse the server's own resolution of them.
DROP_PREFIX = ("-fmacro-prefix-map=", "-ffile-prefix-map=", "-fdiagnostics-color")

# When no clang is there to ask: the ones ESP-IDF 6.1's GCC 15 passes.
KNOWN_UNKNOWN = {"-mlongcalls", "-mtext-section-literals", "-mno-target-align",
                 "-mdisable-hardware-atomics", "-fno-tree-switch-conversion",
                 "-fstrict-volatile-bitfields", "-fno-shrink-wrap", "-freorder-blocks",
                 "-fno-jump-tables", "-fno-malloc-dce"}
KNOWN_UNKNOWN_PREFIX = ("-mfix-esp32-psram-cache", "-fstrict-flex-arrays=",
                        "-fzero-init-padding-bits=")


# A shell word: plain characters, a backslash and the one it escapes, or a
# quoted run. shlex alone took ten seconds over a database of 40 MB, the
# command lines being 20 000 characters each; it now sees only the few
# words that have a quote or a backslash in them.
WORD = re.compile(r"""(?:[^\s'"\\]+|\\.|'[^']*'|"(?:[^"\\]|\\.)*")+""")


def split(command):
    """COMMAND split as a POSIX shell splits it."""
    return [w if not any(c in w for c in "'\"\\") else shlex.split(w)[0]
            for w in WORD.findall(command)]


def core_dir():
    return os.environ.get("PLATFORMIO_CORE_DIR") or os.path.expanduser("~/.platformio")


def resolve(name, cache={}):
    """NAME in full: as given when it has a directory, else from PATH,
    else from PlatformIO's toolchains."""
    if os.sep in name:
        return name
    if name not in cache:
        found = shutil.which(name)
        if not found:
            packages = os.path.join(core_dir(), "packages")
            for pkg in sorted(os.listdir(packages)) if os.path.isdir(packages) else []:
                candidate = os.path.join(packages, pkg, "bin", name)
                if pkg.startswith("toolchain-") and os.access(candidate, os.X_OK):
                    found = candidate
                    break
        cache[name] = found or name
    return cache[name]


def is_cross(compiler):
    """Whether COMPILER builds for another machine: one of PlatformIO's
    toolchains, or named for a target, xtensa-...-elf-gcc."""
    base = os.path.basename(compiler)
    return (compiler.startswith(os.path.join(core_dir(), "packages") + os.sep)
            or any(t in base for t in ("-elf-", "-eabi-", "-eabihf-")))


def declares_isinf(compiler, args, directory, cache={}):
    """Whether COMPILER's C library declares int isinf(double) and isnan,
    asked of COMPILER with the defines and specs of ARGS."""
    if compiler not in cache:
        keep = [a for a in args if a.startswith(("-D", "-U", "-specs=", "--specs=", "-std="))]
        probe = "#include <math.h>\nint (*a)(double) = ::isinf;\nint (*b)(double) = ::isnan;\n"
        try:
            run = subprocess.run([compiler, "-x", "c++", "-fsyntax-only", "-"] + keep,
                                 input=probe, capture_output=True, text=True, cwd=directory,
                                 timeout=60)
            cache[compiler] = run.returncode == 0
        except (OSError, subprocess.SubprocessError):
            cache[compiler] = False
    return cache[compiler]


def is_cxx(compiler):
    return os.path.basename(compiler).endswith(("g++", "c++", "clang++"))


def find_clang():
    clang = shutil.which("clang")
    if not clang and shutil.which("clangd"):
        sibling = os.path.join(os.path.dirname(os.path.realpath(shutil.which("clangd"))), "clang")
        clang = sibling if os.access(sibling, os.X_OK) else None
    return clang


def unknown_to_clang(flags):
    """The FLAGS clang has never heard of, whatever the target: one run
    of clang, which names each it does not know."""
    clang = find_clang()
    if not clang:
        return {f for f in flags
                if f in KNOWN_UNKNOWN or f.startswith(KNOWN_UNKNOWN_PREFIX)}
    run = subprocess.run([clang, "-x", "c", "-fsyntax-only", "-"] + sorted(flags),
                         input="", capture_output=True, text=True)
    unknown = set()
    for line in run.stderr.splitlines():
        for marker in ("unknown argument: '", "unknown argument '"):
            if marker in line:
                unknown.add(line.split(marker, 1)[1].split("'", 1)[0])
    return unknown


def main(root):
    src = os.path.join(root, "compile_commands.json")
    with open(src, encoding="utf-8") as f:
        db = json.load(f)
    entries = []
    for e in db:
        args = e.get("arguments") or split(e["command"])
        entries.append((e, args))
    candidates = {a for _, args in entries for a in args[1:]
                  if a.startswith(("-f", "-m", "--param")) and not a.startswith(DROP_PREFIX)}
    unknown = unknown_to_clang(candidates)
    out = []
    for e, args in entries:
        compiler = resolve(args[0])
        kept = [a for a in args[1:] if a not in unknown and not a.startswith(DROP_PREFIX)]
        extra = ADD[:]
        if is_cross(compiler):
            extra[:0] = ["-Xclang", "-nostdsysteminc"]
            if is_cxx(compiler) and declares_isinf(compiler, kept, e["directory"]):
                extra += ["-D_GLIBCXX_HAVE_OBSOLETE_ISINF=1", "-D_GLIBCXX_HAVE_OBSOLETE_ISNAN=1"]
        entry = {"directory": e["directory"], "file": e["file"],
                 "arguments": [compiler] + extra + kept}
        if "output" in e:
            entry["output"] = e["output"]
        out.append(entry)
    dest_dir = os.path.join(root, ".pio", "clangd")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, "compile_commands.json")
    tmp = dest + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(out, f)
    os.replace(tmp, dest)
    print(f"{len(out)} entries, {len(unknown)} flags clang does not know taken out: "
          + " ".join(sorted(unknown)))


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip().splitlines()[2].strip())
    main(os.path.abspath(sys.argv[1]))
