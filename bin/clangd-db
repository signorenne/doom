#!/usr/bin/env python3
"""Write a compilation database clangd can read, from any project's.

  clangd-db SRC DEST

SRC is a compile_commands.json, PlatformIO's, ESP-IDF's, a CMake build
directory's, west's, bear's: the real compiler's command lines, which
clang cannot always take as they are. This writes DEST, which Emacs
starts clangd on, and beside it query-drivers, the cross compilers clangd
may run to learn their headers, one a line. For every entry:

- the compiler named in full, found in the toolchain directories when it
  is on no PATH, so clangd can ask it for its headers;
- the flags clang does not know taken out, as clang itself reports them,
  since each is an error at the top of every file;
- no system directories of the host for a cross compiler
  (-Xclang -nostdsysteminc): its own come from the compiler, and the
  host's do not fit its target;
- libstdc++ told that the C library declares isinf and isnan when it
  does, which GCC tolerates and clang does not.

A compiler is a cross compiler when it says it builds for another
machine (-dumpmachine), not by its name. A database with no cross
compiler and nothing clang refuses is left as it is: nothing is written
and the exit status is 3, so clangd reads SRC itself.
"""
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

ADD = ["-Wno-unknown-warning-option", "-Wno-unknown-attributes",
       "-Wno-ignored-optimization-argument"]

# What clang is not asked about: it knows them, but they only rename
# paths in diagnostics and confuse the server's own resolution of them.
DROP_PREFIX = ("-fmacro-prefix-map=", "-ffile-prefix-map=", "-fdiagnostics-color")

# Flags clang does not know, used when no clang is there to ask.
KNOWN_UNKNOWN = {"-mlongcalls", "-mtext-section-literals", "-mno-target-align",
                 "-mdisable-hardware-atomics", "-fno-tree-switch-conversion",
                 "-fstrict-volatile-bitfields", "-fno-shrink-wrap", "-freorder-blocks",
                 "-fno-jump-tables", "-fno-malloc-dce"}
KNOWN_UNKNOWN_PREFIX = ("-mfix-esp32-psram-cache", "-fstrict-flex-arrays=",
                        "-fzero-init-padding-bits=")

NOTHING_TO_CHANGE = 3


# A shell word: plain characters, a backslash and the one it escapes, or a
# quoted run. shlex is slow on long command lines, so it only sees the
# few words that have a quote or a backslash in them.
WORD = re.compile(r"""(?:[^\s'"\\]+|\\.|'[^']*'|"(?:[^"\\]|\\.)*")+""")


def split(command):
    """COMMAND split as a POSIX shell splits it."""
    return [w if not any(c in w for c in "'\"\\") else shlex.split(w)[0]
            for w in WORD.findall(command)]


def pio_packages():
    core = os.environ.get("PLATFORMIO_CORE_DIR") or os.path.expanduser("~/.platformio")
    return os.path.join(core, "packages")


def toolchain_dirs():
    """Where cross toolchains are kept when they are on no PATH: PlatformIO's
    packages, ESP-IDF's tools, the Zephyr SDK, Arm's installer on macOS."""
    idf = os.environ.get("IDF_TOOLS_PATH") or os.path.expanduser("~/.espressif")
    patterns = [os.path.join(pio_packages(), "toolchain-*", "bin"),
                os.path.join(idf, "tools", "*", "*", "*", "bin"),
                os.path.expanduser("~/zephyr-sdk-*/*/bin"),
                "/opt/zephyr-sdk-*/*/bin",
                "/Applications/ArmGNUToolchain/*/*/bin"]
    return [d for p in patterns for d in sorted(glob.glob(p))]


def resolve(name, cache={}):
    """NAME in full: as given when it has a directory, else from PATH,
    else from the toolchain directories."""
    if os.sep in name:
        return name
    if name not in cache:
        found = shutil.which(name)
        if not found:
            for d in toolchain_dirs():
                candidate = os.path.join(d, name)
                if os.access(candidate, os.X_OK):
                    found = candidate
                    break
        cache[name] = found or name
    return cache[name]


def machine(compiler, cache={}):
    """The target COMPILER says it builds for, or None."""
    if compiler not in cache:
        try:
            run = subprocess.run([compiler, "-dumpmachine"], capture_output=True,
                                 text=True, timeout=20)
            cache[compiler] = run.stdout.strip() if run.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            cache[compiler] = None
    return cache[compiler]


def host_machine():
    for cc in ("cc", "clang", "gcc"):
        if shutil.which(cc):
            found = machine(shutil.which(cc))
            if found:
                return found
    return None


def native(target, host):
    """Whether TARGET is this machine's: the same triple, or both Apple's,
    or both Linux on the same processor."""
    if not target or not host or target == host:
        return True
    if "darwin" in target and "darwin" in host:
        return True
    arch = lambda t: t.split("-", 1)[0].replace("arm64", "aarch64")
    return "linux" in target and "linux" in host and arch(target) == arch(host)


def is_cross(compiler, host):
    """Whether COMPILER builds for another machine. Asked of the compiler;
    one that cannot be run is judged by where it is and its name."""
    target = machine(compiler)
    if target is not None:
        return not native(target, host)
    base = os.path.basename(compiler)
    return (compiler.startswith(pio_packages() + os.sep)
            or any(t in base for t in ("-elf-", "-eabi-", "-eabihf-")))


def declares_isinf(compiler, args, directory, cache={}):
    """Whether COMPILER's C library declares int isinf(double) and isnan,
    asked of COMPILER with the defines and specs of ARGS."""
    if compiler not in cache:
        keep = [a for a in args if a.startswith(("-D", "-U", "-specs=", "--specs=", "-std="))]
        probe = "#include <math.h>\nint (*a)(double) = ::isinf;\nint (*b)(double) = ::isnan;\n"
        try:
            run = subprocess.run([compiler, "-x", "c++", "-fsyntax-only", "-"] + keep,
                                 input=probe, capture_output=True, text=True, cwd=directory,
                                 timeout=60)
            cache[compiler] = run.returncode == 0
        except (OSError, subprocess.SubprocessError):
            cache[compiler] = False
    return cache[compiler]


def is_cxx(compiler):
    return os.path.basename(compiler).endswith(("g++", "c++", "clang++"))


def find_clang():
    clang = shutil.which("clang")
    if not clang and shutil.which("clangd"):
        sibling = os.path.join(os.path.dirname(os.path.realpath(shutil.which("clangd"))), "clang")
        clang = sibling if os.access(sibling, os.X_OK) else None
    return clang


def unknown_to_clang(flags):
    """The FLAGS clang has never heard of, whatever the target: one run
    of clang, which names each it does not know."""
    clang = find_clang()
    if not clang:
        return {f for f in flags
                if f in KNOWN_UNKNOWN or f.startswith(KNOWN_UNKNOWN_PREFIX)}
    run = subprocess.run([clang, "-x", "c", "-fsyntax-only", "-"] + sorted(flags),
                         input="", capture_output=True, text=True)
    unknown = set()
    for line in run.stderr.splitlines():
        for marker in ("unknown argument: '", "unknown argument '"):
            if marker in line:
                unknown.add(line.split(marker, 1)[1].split("'", 1)[0])
    return unknown


def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def main(src, dest):
    with open(src, encoding="utf-8") as f:
        db = json.load(f)
    entries = []
    for e in db:
        args = e.get("arguments") or split(e["command"])
        entries.append((e, args))
    candidates = {a for _, args in entries for a in args[1:]
                  if a.startswith(("-f", "-m", "--param")) and not a.startswith(DROP_PREFIX)}
    unknown = unknown_to_clang(candidates)
    host = host_machine()
    cross = set()
    changed = bool(unknown)
    out = []
    for e, args in entries:
        compiler = resolve(args[0])
        kept = [a for a in args[1:] if a not in unknown and not a.startswith(DROP_PREFIX)]
        changed = changed or len(kept) != len(args) - 1
        extra = ADD[:]
        if is_cross(compiler, host):
            cross.add(compiler)
            extra[:0] = ["-Xclang", "-nostdsysteminc"]
            if is_cxx(compiler) and declares_isinf(compiler, kept, e["directory"]):
                extra += ["-D_GLIBCXX_HAVE_OBSOLETE_ISINF=1", "-D_GLIBCXX_HAVE_OBSOLETE_ISNAN=1"]
        entry = {"directory": e["directory"], "file": e["file"],
                 "arguments": [compiler] + extra + kept}
        if "output" in e:
            entry["output"] = e["output"]
        out.append(entry)
    if not cross and not changed:
        print(f"{len(out)} entries, nothing clang cannot read")
        return NOTHING_TO_CHANGE
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    write(dest, json.dumps(out))
    write(os.path.join(os.path.dirname(dest), "query-drivers"),
          "".join(c + "\n" for c in sorted(cross) if os.sep in c))
    print(f"{len(out)} entries, {len(cross)} cross compilers, {len(unknown)} flags clang "
          "does not know taken out: " + " ".join(sorted(unknown)))
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip().splitlines()[2].strip())
    sys.exit(main(os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])))
